{
  "name": "signalops-aiops-portfolio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "vinext build && node --import tsx scripts/export-pages.tsx && node --test tests/rendered-html.test.mjs",
    "report": "python3 scripts/generate_sample_logs.py && python3 -m signalops analyze --input data/sample_logs.jsonl --baseline data/baseline_logs.jsonl --output public/data/report.json",
    "python:test": "python3 -m pytest",
    "export:pages": "node --import tsx scripts/export-pages.tsx",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "verify": "python3 -m pytest && vinext build && node --import tsx scripts/export-pages.tsx && node --test tests/rendered-html.test.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13"
  },
  "type": "module"
}
